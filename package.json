{
  "name": "commonpost-mcp",
  "version": "0.10.1",
  "description": "Commonpost MCP for Thunderbird - MCP server that gives AI assistants access to Thunderbird email, contacts, and calendars (continuation of thunderbird-mcp)",
  "author": "Commonpost contributors (continuation of thunderbird-mcp by Tomasz Kasperczyk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/commonpost/thunderbird-mcp"
  },
  "keywords": [
    "mcp",
    "thunderbird",
    "email",
    "ai",
    "claude"
  ],
  "bin": {
    "commonpost-mcp": "./mcp-bridge.cjs"
  },
  "files": [
    "mcp-bridge.cjs",
    "extension/",
    "scripts/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.cjs test/*.js",
    "test:tb": "bash scripts/tb-bench.sh run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "fast-check": "4.10.2",
    "globals": "^17.5.0"
  },
  "homepage": "https://github.com/commonpost/thunderbird-mcp"
}
