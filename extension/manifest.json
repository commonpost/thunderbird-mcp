{
  "manifest_version": 2,
  "name": "Commonpost MCP for Thunderbird",
  "version": "0.8.2",
  "description": "MCP server for AI assistants to access email, contacts, and calendars. Continuation of thunderbird-mcp by Tomasz Kasperczyk.",
  "homepage_url": "https://github.com/commonpost/thunderbird-mcp",
  "developer": {
    "name": "Commonpost contributors",
    "url": "https://github.com/commonpost"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "commonpost-mcp@commonpost.github.io",
      "update_url": "https://commonpost.github.io/thunderbird-mcp/updates.json",
      "strict_min_version": "156.0",
      "strict_max_version": "200.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "commonpostMcp": {
      "schema": "mcp_server/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "commonpostMcp"
          ]
        ],
        "script": "mcp_server/api.js"
      }
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "accountsRead",
    "addressBooks",
    "messagesRead",
    "messagesMove",
    "accountsFolders",
    "compose"
  ],
  "web_accessible_resources": []
}
